# PostgreSQL Database
POSTGRES_PASSWORD=postgres123

# RabbitMQ Message Broker
RABBITMQ_PASSWORD=guest123

# JWT Authentication (minimum 256 bits / 32 characters)
JWT_SECRET=DevSecretKey123456789012345678901234567890123456789012345678901234567890
JWT_ISSUER=kantarv2
JWT_AUDIENCE=kantarUsers

# AWS S3 Credentials
AWS_S3_ACCESS_KEY=your-access-key-here
AWS_S3_SECRET_KEY=your-secret-key-here

# Email Settings (Gmail SMTP - use App Password, not regular password)
EMAIL_SENDER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password-here

# Groq LLM API
GROQ_API_KEY=your-groq-api-key-here

# Grafana Loki (Optional - leave empty if using local Loki)
LOKI_URI=http://loki:3100
LOKI_USERNAME=
LOKI_PASSWORD=
