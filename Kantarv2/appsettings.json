{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "Gemini": {
    "ApiKey": ""
  },
  "Groq": {
    "ApiKey": "",
    "Endpoint": "",
    "Model": "llama-3.1-8b-instant"
  },
  "RabbitMQ": {
    "Uri": "amqp://guest:guest@localhost:5672/"
  },
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderEmail": "",
    "SenderName": "Kantar",
    "Password": "",
    "EnableSsl": true
  },
  "AWS": {
    "S3": {
      "AccessKey": "",
      "SecretKey": "",
      "BucketName": "kantar-v2-excel",
      "Region": "eu-central-1"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Appsettings": {
    "Token": "",
    "Issuer": "",
    "Audience": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Grafana.Loki" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://localhost:3100",
          "labels": [
            {
              "key": "app",
              "value": "kantar-api"
            },
            {
              "key": "environment",
              "value": "production"
            }
          ],
          "propertiesAsLabels": [ "level" ]
        }
      },
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "Kantar.API"
    }
  },
  "AllowedHosts": "*"
}
